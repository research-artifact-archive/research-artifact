// Semantic-boundary suite v2 case=empty_transfer variant=unreachable_declaration.
// Metamorphic variants must preserve the registered decision.
// Generated by independent-one-state-reconfiguration-v1; do not edit.
// RQ1 semantic boundary: reachable old endpoint has an empty transfer set.
// Expected FG-DUCS decision: unrealizable.

set ControllableActions = {idle, enter}

OLD_COMPONENT = OLD_READY,
OLD_READY = (idle -> OLD_READY | enter -> OLD_ALT),
OLD_ALT = (idle -> OLD_ALT).
NEW_COMPONENT = (idle -> NEW_COMPONENT).

||OldEnvironment = (OLD_COMPONENT).
||NewEnvironment = (NEW_COMPONENT).

relation R_COMPONENT_FG = {OLD_ALT@OLD_COMPONENT = reconfigure_COMPONENT -> NEW_COMPONENT@NEW_COMPONENT}

ltl_property R_NO_ENTER = [](!enter)

controllerSpec OldSpec = {
    controllable = {ControllableActions}
}
controller ||OldController = OldEnvironment~{OldSpec}.

controllerSpec NewSpec = {
    controllable = {ControllableActions}
}
controller ||NewController = NewEnvironment~{NewSpec}.

updatingController BoundaryCase = {
    oldController = OldController,
    newController = NewController,
    oldEnvironment = {OLD_COMPONENT},
    newEnvironment = {NEW_COMPONENT},
    mapRelation = {R_COMPONENT_FG},
    oldGoal = OldSpec,
    newGoal = NewSpec,
    transition = R_NO_ENTER,
    nonblocking,
    revised_on_the_fly,
    fine_grained
}
UNREACHABLE_AUX = (ghost -> UNREACHABLE_AUX).

||UPDATE_CONTROLLER_OTF_FG = BoundaryCase.
