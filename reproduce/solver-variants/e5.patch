+    private static ActivationSpec<String,Integer> activation(final SafetyTester<Integer> tester, final Set<String> alphabet,List<PhysicalState<String>> domain) {
+        ResidualLanguage<Integer> residual=new ResidualLanguage<Integer>() {
+            public Set<Integer> states(){return tester.states();} public Set<String> alphabet(){return alphabet;}
+            public Integer initialState(){return tester.initialState();} public boolean isError(Integer q){return tester.isError(q);}
+            public Integer step(Integer q,String a){return tester.stepOrStutter(q,a);}
