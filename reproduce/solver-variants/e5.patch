diff --git a/mtsa/src/main/java/ltsa/updatingControllers/otf/TransferDomainRestriction.java b/mtsa/src/main/java/ltsa/updatingControllers/otf/TransferDomainRestriction.java
new file mode 100644
index 0000000..d5648a0
--- /dev/null
+++ b/mtsa/src/main/java/ltsa/updatingControllers/otf/TransferDomainRestriction.java
@@ -0,0 +1,110 @@
+package ltsa.updatingControllers.otf;
+
+import java.util.*;
+
+/** E5 contract preprocessing: retain transfer pairs whose source is the old initial state. */
+public final class TransferDomainRestriction {
+    public static final String PROPERTY = "mtsa.otf.transferDomain";
+    private TransferDomainRestriction() { }
+
+    public static <S, M> Result<S, M> apply(FineGrainedUpdateProblem<S, M> source, String configured) {
+        return apply(source, configured, java.util.function.Function.identity(), "old_local_initial_state");
+    }
+
+    /** The frontend may erase implementation-only observer coordinates for the physical-state comparison. */
+    public static <S, M> Result<S, M> apply(FineGrainedUpdateProblem<S, M> source, String configured,
+            java.util.function.Function<? super S, ?> physicalState, String comparisonScope) {
+        Objects.requireNonNull(source, "source");
+        Objects.requireNonNull(physicalState, "physicalState");
+        Objects.requireNonNull(comparisonScope, "comparisonScope");
+        String mode = Objects.requireNonNull(configured, "mode").trim();
+        if (!"none".equals(mode) && !"initial".equals(mode))
+            throw new IllegalArgumentException(PROPERTY + " must be none or initial: " + configured);
+        if (!"none".equals(mode) && !"none".equals(source.contractMerge()))
+            throw new IllegalArgumentException("Transfer-domain restriction must precede contract merging");
+        List<VersionedComponent<S>> components = new ArrayList<>();
+        List<Map<String, Object>> census = new ArrayList<>();
+        for (VersionedComponent<S> c : source.components()) {
+            Map<S, Set<S>> retained = c.transferRelation();
+            if ("initial".equals(mode)) {
+                retained = new LinkedHashMap<>();
+                Object initialPhysical = physicalState.apply(c.oldLts().initialState());
+                for (Map.Entry<S,Set<S>> pair : c.transferRelation().entrySet())
+                    if (Objects.equals(initialPhysical, physicalState.apply(pair.getKey())) && !pair.getValue().isEmpty())
+                        retained.put(pair.getKey(), pair.getValue());
+            }
+            VersionedComponent<S> filtered = "none".equals(mode) ? c : new VersionedComponent<>(
+                    c.id(), c.oldLts(), c.newLts(), retained, c.reconfigureAction(),
+                    c.oldEnvironmentActions(), c.newEnvironmentActions());
+            components.add(filtered);
+            Map<String, Object> row = new LinkedHashMap<>();
+            row.put("component_id", c.id());
+            row.put("old_initial_state", String.valueOf(c.oldLts().initialState()));
+            row.put("old_initial_physical_state", String.valueOf(physicalState.apply(c.oldLts().initialState())));
+            row.put("comparison_scope", comparisonScope);
+            row.put("old_states", c.oldLts().states().size());
+            Set<Object> physicalStates = new LinkedHashSet<>();
+            for (S q : c.oldLts().states()) physicalStates.add(physicalState.apply(q));
+            row.put("old_physical_states", physicalStates.size());
+            row.put("original_domain_states", domain(c.transferRelation()));
+            row.put("retained_domain_states", domain(retained));
+            row.put("original_pairs", pairs(c.transferRelation()));
+            row.put("retained_pairs", pairs(retained));
+            row.put("original_physical_domain_states", physicalDomain(c.transferRelation(), physicalState));
+            row.put("retained_physical_domain_states", physicalDomain(retained, physicalState));
+            row.put("original_physical_pairs", physicalPairs(c.transferRelation(), physicalState));
+            row.put("retained_physical_pairs", physicalPairs(retained, physicalState));
+            census.add(Collections.unmodifiableMap(row));
+        }
+        if ("none".equals(mode)) return new Result<>(source, mode, census);
+        FineGrainedUpdateProblem.Builder<S, M> b = FineGrainedUpdateProblem.<S, M>builder()
+                .components(components).requirements(source.requirements())
+                .normalActions(source.normalActions()).controllableNormalActions(source.controllableNormalActions())
+                .commonAlphabet(source.commonAlphabet()).hotSwapActions(source.hotSwapInAction(), source.hotSwapOutAction())
+                .mergedContract("none", source.hasExhaustiveEndpointCoverage());
+        for (String after : source.updateActions()) for (String before : source.directPredecessors(after))
+            b.addPrecedence(before, after);
+        for (CanonicalUpdateConfiguration<S, M> q : source.initialConfigurations()) {
+            Map<String, M> old = new LinkedHashMap<>();
+            for (String id : source.oldRequirementIds()) old.put(id, q.activeTesterStates().get(id));
+            b.addInitialSnapshot(new InitialSnapshot<>(q.physicalState(), old));
+        }
+        for (GoalSignature<S, M> goal : source.goalSignatures()) b.addGoalSignature(goal);
+        return new Result<>(b.build(), mode, census);
+    }
+
+    private static <S> long physicalDomain(Map<S,Set<S>> relation, java.util.function.Function<? super S,?> project) {
+        Set<Object> values = new LinkedHashSet<>();
+        for (Map.Entry<S,Set<S>> pair : relation.entrySet()) if (!pair.getValue().isEmpty()) values.add(project.apply(pair.getKey()));
+        return values.size();
+    }
+    private static <S> long physicalPairs(Map<S,Set<S>> relation, java.util.function.Function<? super S,?> project) {
+        Set<List<Object>> values = new LinkedHashSet<>();
+        for (Map.Entry<S,Set<S>> pair : relation.entrySet()) for (S target : pair.getValue())
+            values.add(Arrays.<Object>asList(project.apply(pair.getKey()), project.apply(target)));
+        return values.size();
+    }
+    private static long domain(Map<?, ? extends Set<?>> relation) {
+        long count = 0; for (Set<?> targets : relation.values()) if (!targets.isEmpty()) count++; return count;
+    }
+    private static long pairs(Map<?, ? extends Set<?>> relation) {
+        long count = 0; for (Set<?> targets : relation.values()) count += targets.size(); return count;
+    }
+    public static final class Result<S, M> {
+        private final FineGrainedUpdateProblem<S, M> problem;
+        private final String mode;
+        private final List<Map<String, Object>> components;
+        private Result(FineGrainedUpdateProblem<S, M> problem, String mode, List<Map<String, Object>> census) {
+            this.problem = problem; this.mode = mode;
+            this.components = Collections.unmodifiableList(new ArrayList<>(census));
+        }
+        public FineGrainedUpdateProblem<S, M> problem() { return problem; }
+        public String mode() { return mode; }
+        public List<Map<String, Object>> components() { return components; }
+        public long total(String field) {
+            long total = 0;
+            for (Map<String, Object> c : components) total += ((Number) c.get(field)).longValue();
+            return total;
+        }
+    }
+}
