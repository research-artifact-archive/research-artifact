+    /**
+     * Parses the revised OTF-DUCS option
+     * {@code precedence = { updateAction < updateAction, ... }}.
+     * "precedence" deliberately remains a contextual keyword so existing
+     * FSP models may continue to use that action name outside this definition.
+     */
+    private void parseUpdatePrecedence(
+            UpdatingControllersDefinition definition) {
+        expectBecomes();
+        next_symbol();
+        current_is(Symbol.LCURLY, "{ expected after precedence =");
+        next_symbol();
+
+        while (current.kind != Symbol.RCURLY) {
+            current_is(
+                    Symbol.IDENTIFIER,
+                    "update action expected as precedence predecessor");
+            String before = current.toString();
+            next_symbol();
+
+            current_is(Symbol.LESS_THAN, "< expected in update precedence");
+            next_symbol();
+
+            current_is(
+                    Symbol.IDENTIFIER,
+                    "update action expected as precedence successor");
+            String after = current.toString();
+            definition.addUpdatePrecedence(before, after);
+            next_symbol();
+
+            if (current.kind == Symbol.COMMA) {
+                next_symbol();
+            } else if (current.kind != Symbol.RCURLY) {
+                error(", or } expected in update precedence");
+            }
+        }
+        next_symbol();
+    }
