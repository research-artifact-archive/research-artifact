+	/** Solver-free registered-route validation used by focused negative tests. */
+	static void validateRegisteredM9DeterministicEndpointInput(
+			CompositeState compositeState,
+			ControllerGoal<String> goal,
+			LTSOutput output) {
+		if (compositeState == null || goal == null || output == null
+				|| compositeState.composition == null) {
+			throw new IllegalArgumentException(
+					"Registered M9 endpoint source, goal, and output are required.");
+		}
+		CompactState source = compositeState.composition;
+		if (MTSUtils.isMTSRepresentation(source)
+				|| source.isNonDeterministic() || source.hasTau()
+				|| !goal.getBuchi().isEmpty()) {
+			throw new IllegalArgumentException(
+					"Registered M9 endpoint route requires deterministic tau-free non-Buchi LTS input.");
+		}
+		if (!goal.getSelfLoopsUncontrollable().isEmpty()) {
+			throw new IllegalArgumentException(
+					"Registered M9 endpoint route forbids legacy controller rewriting.");
+		}
+		if (source.alphabet == null) {
+			throw new IllegalArgumentException(
+					"Registered M9 endpoint source alphabet is absent.");
+		}
+		for (String action : source.alphabet) {
+			if ("*".equals(action)) {
