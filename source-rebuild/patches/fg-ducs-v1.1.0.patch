+	/**
+	 * The only worker-visible M9 endpoint operation.  It arms the process ledger,
+	 * performs exactly one registered native endpoint synthesis, derives every
+	 * immutable semantic object, seals the matching receipt core, and publishes
+	 * it without returning the live controller or an intermediate authority.
+	 */
+	static M9EndpointReceiptBundle.PublishedReceipt
+			synthesiseValidateSealAndPublishRegisteredM9EndpointOnce(
+				M9EndpointPreparedCase preparedCase,
+				M9EndpointReceiptCore.Bindings receiptBindings,
+				M9EndpointReceiptBundle.PublicationTarget publicationTarget)
+				throws IOException {
+		if (preparedCase == null || receiptBindings == null
+				|| publicationTarget == null) {
+			throw new IllegalArgumentException(
+					"Registered prepared case, receipt, and publication authorities are required.");
+		}
+		M9EndpointPreparedCase.Materialization materialization =
+				preparedCase.consume(M9_PREPARED_CASE_ACCESS);
+		String boundSourceModel = receiptBindings.getSha256Bindings().get(
+				"selected_translation_source_sha256");
+		if (!materialization.getSourceModelSha256().equals(boundSourceModel)
+				|| receiptBindings.getSourceBindingFileCount() < 1L
+				|| receiptBindings.getSourceBindingTotalBytes()
+						< materialization.getSourceModelSizeBytes()) {
+			throw new IllegalArgumentException(
+					"Prepared source bytes differ from the registered receipt binding.");
+		}
+		if (ComputerOptions.getInstance().getAllowedThreads() != 1) {
+			throw new IllegalArgumentException(
+					"Registered endpoint synthesis requires exactly one ranking thread.");
+		}
+		CompositeState source = materialization.getSource();
+		ControllerGoal<String> goal = materialization.getGoal();
+		LTSOutput output = materialization.getOutput();
+		CompactState materializedEnew = materialization.getMaterializedEnew();
+		validateRegisteredM9DeterministicEndpointInput(source, goal, output);
+		validateRegisteredM9EndpointRoleNames(source, materializedEnew);
+		M9ClosedLoopEndpointSnapshot.requireRegisteredNativeCompositionProfile();
+		materialization.requireTraditionalPreGrEligible(M9_PREPARED_CASE_ACCESS);
+		TraditionalPreGrSnapshotHook.SealedCapture traditionalPreGr =
+				materialization.captureTraditionalPreGr(M9_PREPARED_CASE_ACCESS);
+		try (M9EndpointSynthesisHook.Scope scope =
+				M9EndpointSynthesisHook.arm()) {
+			return completeRegisteredM9EndpointAttempt(
+					source, goal, output, materializedEnew,
+					materialization.getEnewAdmission(),
+					materialization.getEnvironmentPrefix(), receiptBindings,
+					publicationTarget, traditionalPreGr, scope);
+		}
+	}
+
+	static void validateRegisteredM9EndpointRoleNames(
+			CompositeState source,
+			CompactState materializedEnew) {
+		if (source == null || materializedEnew == null
+				|| Objects.equals(materializedEnew.getName(), source.getName())) {
+			throw new IllegalArgumentException(
+					"Registered Enew and Cnew role names must be distinct.");
+		}
+	}
