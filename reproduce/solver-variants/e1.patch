+        FineGrainedSuccessorOracle<String, String> g = FineGrainedOtfDucs.game(p);
+        CanonicalUpdateConfiguration<String, String> q = p.initialConfigurations().get(0);
+        q = g.post(q, "ablation.merge.starts").iterator().next();
+        assertEquals("k", q.activeTesterStates().get("new1"));
+        assertEquals("k", q.activeTesterStates().get("new2"));
+        assertTrue(p.isSafe(q));
+        q = g.post(q, "ablation.merge.stops").iterator().next();
+        assertFalse(q.isTesterActive("old1")); assertFalse(q.isTesterActive("old2"));
+        assertTrue(solve(p).isWinning());
