// Quiescent-only component transfer: no in-flight state is mapped.
relation R_AGENCY_FG = {
    OLD_AGENCY@OLD_AGENCY = reconfigure_AGENCY -> NEW_AGENCY@NEW_AGENCY
}

relation R_SERVICE_00_FG = {
    OLD_SERVICE_00@OLD_SERVICE_00 = reconfigure_SERVICE_00 -> NEW_SERVICE_00@NEW_SERVICE_00
}

relation R_SERVICE_01_FG = {
    OLD_SERVICE_01@OLD_SERVICE_01 = reconfigure_SERVICE_01 -> NEW_SERVICE_01@NEW_SERVICE_01
}

relation R_SERVICE_02_FG = {
    OLD_SERVICE_02@OLD_SERVICE_02 = reconfigure_SERVICE_02 -> NEW_SERVICE_02@NEW_SERVICE_02
}

relation R_SERVICE_03_FG = {
    OLD_SERVICE_03@OLD_SERVICE_03 = reconfigure_SERVICE_03 -> NEW_SERVICE_03@NEW_SERVICE_03
}

controllerSpec OldSpec = {
    controllable = {ControllableActions}
    marking = {agency.succ, agency.fail}
    nonblocking
}
controller ||OldController = OldEnvironment~{OldSpec}.

controllerSpec NewSpec = {
    controllable = {ControllableActions}
    marking = {agency.succ, agency.fail}
    nonblocking
}
controller ||NewController = NewEnvironment~{NewSpec}.

updatingController TravelAgencyDerivedUpdate = {
    oldController = OldController,
    newController = NewController,
    oldEnvironment = {OLD_AGENCY, OLD_SERVICE_00, OLD_SERVICE_01, OLD_SERVICE_02, OLD_SERVICE_03},
    newEnvironment = {NEW_AGENCY, NEW_SERVICE_00, NEW_SERVICE_01, NEW_SERVICE_02, NEW_SERVICE_03},
    mapRelation = {R_AGENCY_FG, R_SERVICE_00_FG, R_SERVICE_01_FG, R_SERVICE_02_FG, R_SERVICE_03_FG},
    oldGoal = OldSpec,
    newGoal = NewSpec,
    nonblocking,
    revised_on_the_fly,
    fine_grained
}
||UPDATE_CONTROLLER_OTF_FG = TravelAgencyDerivedUpdate.
