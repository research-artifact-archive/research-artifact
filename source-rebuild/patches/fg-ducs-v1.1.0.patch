+    /**
+     * Parses a deterministic BFS-indexed subset of the reachable new endpoint:
+     * {@code loadable_new_states = { 0, 2, ... }}.
+     */
+    private void parseLoadableNewStates(
+            UpdatingControllersDefinition definition) {
+        expectBecomes();
+        next_symbol();
+        current_is(
+                Symbol.LCURLY,
+                "{ expected after loadable_new_states =");
+        next_symbol();
+
+        LinkedHashSet<Integer> indices = new LinkedHashSet<Integer>();
+        while (current.kind != Symbol.RCURLY) {
+            current_is(
+                    Symbol.INT_VALUE,
+                    "nonnegative endpoint state index expected");
+            int index;
+            try {
+                index = current.doubleValue().intValueExact();
+            } catch (ArithmeticException invalidInteger) {
+                error("loadable endpoint state index must be an exact 32-bit integer");
+                return;
+            }
+            if (index < 0) {
+                error("loadable endpoint state index must be nonnegative");
+            }
+            if (!indices.add(Integer.valueOf(index))) {
+                error("duplicate loadable endpoint state index: " + index);
+            }
+            next_symbol();
+            if (current.kind == Symbol.COMMA) {
+                next_symbol();
+            } else if (current.kind != Symbol.RCURLY) {
+                error(", or } expected in loadable_new_states");
+            }
+        }
+        if (indices.isEmpty()) {
+            error("loadable_new_states must contain at least one index");
+        }
+        definition.setLoadableNewEndpointStateIndices(indices);
+        next_symbol();
+    }
