+public class ContractMergeTest {
+    @Test public void exactPaperCellHasWinningFineAndLosingBulkTransfers() {
+        FineGrainedUpdateProblem<String, String> p = cell();
+        assertTrue(solve(p).isWinning());
+        FineGrainedUpdateProblem<String, String> merged = p.withContractMerge("transfers");
+        assertFalse(solve(merged).isWinning());
+        for (CanonicalUpdateConfiguration<String, String> root : merged.initialConfigurations())
+            assertTrue(FineGrainedOtfDucs.game(merged).post(root, "ablation.merge.transfers").isEmpty());
+        checkEveryPost(merged);
+    }
+
+    @Test public void noneIsIdentityIncludingStatesAndQueries() {
+        FineGrainedUpdateProblem<String, String> p = cell();
+        assertSame(p, p.withContractMerge("none"));
+        OtfDucsResult<?, ?, ?> a = solve(p), b = solve(p.withContractMerge("none"));
+        assertEquals(a.isWinning(), b.isWinning());
+        assertEquals(a.statistics().discoveredStates(), b.statistics().discoveredStates());
+        assertEquals(a.statistics().queriedStateActionPairs(), b.statistics().queriedStateActionPairs());
+    }
+
+    @Test public void oneComponentPreservesDecisionAndFullStateCount() {
+        FineGrainedUpdateProblem<String, String> p = simple(1, false);
+        FineGrainedUpdateProblem<String, String> merged = p.withContractMerge("transfers");
+        assertEquals(solve(p).isWinning(), solve(merged).isWinning());
+        assertEquals(new DirectFullStrongSolver<>(FineGrainedOtfDucs.game(p)).synthesize().statistics().discoveredStates(),
+                new DirectFullStrongSolver<>(FineGrainedOtfDucs.game(merged)).synthesize().statistics().discoveredStates());
+        checkEveryPost(merged);
+    }
+
+    @Test public void simultaneousTransferKeepsAllCartesianOutcomes() {
+        FineGrainedUpdateProblem<String, String> p = simple(2, false).withContractMerge("transfers");
+        Set<CanonicalUpdateConfiguration<String, String>> outcomes = FineGrainedOtfDucs.game(p)
+                .post(p.initialConfigurations().get(0), "ablation.merge.transfers");
+        assertEquals(4, outcomes.size());
+        for (CanonicalUpdateConfiguration<String, String> q : outcomes) {
+            assertTrue(q.physicalState().allNew()); assertTrue(q.pendingActions().isEmpty());
+        }
+        // Only all-good is a goal; the adversarial bad outcomes must not disappear.
+        assertFalse(solve(p).isWinning());
+        checkEveryPost(p);
+    }
