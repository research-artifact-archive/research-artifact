// Semantic-boundary suite v2 case=nondeterministic_transfer variant=identity.
// Metamorphic variants must preserve the registered decision.
// Generated by independent-one-state-reconfiguration-v1; do not edit.
// RQ1 semantic boundary: all outcomes of a nondeterministic transfer are winning goals.
// Expected FG-DUCS decision: realizable.

set ControllableActions = {idle, choose, reset}

OLD_COMPONENT = (idle -> OLD_COMPONENT).
NEW_COMPONENT = NEW_READY,
NEW_READY = (idle -> NEW_READY | choose -> NEW_ALT),
NEW_ALT = (idle -> NEW_ALT | reset -> NEW_READY).

||OldEnvironment = (OLD_COMPONENT).
||NewEnvironment = (NEW_COMPONENT).

relation R_COMPONENT_FG = {OLD_COMPONENT@OLD_COMPONENT = reconfigure_COMPONENT -> NEW_READY@NEW_COMPONENT,
    OLD_COMPONENT@OLD_COMPONENT = reconfigure_COMPONENT -> NEW_ALT@NEW_COMPONENT}

controllerSpec OldSpec = {
    controllable = {ControllableActions}
}
controller ||OldController = OldEnvironment~{OldSpec}.

controllerSpec NewSpec = {
    controllable = {ControllableActions}
}
controller ||NewController = NewEnvironment~{NewSpec}.

updatingController BoundaryCase = {
    oldController = OldController,
    newController = NewController,
    oldEnvironment = {OLD_COMPONENT},
    newEnvironment = {NEW_COMPONENT},
    mapRelation = {R_COMPONENT_FG},
    oldGoal = OldSpec,
    newGoal = NewSpec,
    nonblocking,
    revised_on_the_fly,
    fine_grained
}
||UPDATE_CONTROLLER_OTF_FG = BoundaryCase.
