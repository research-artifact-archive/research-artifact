// Semantic-boundary suite v2 case=precedence_chain variant=component_permutation.
// Metamorphic variants must preserve the registered decision.
// Generated by concrete-lts-semantic-boundaries-v2; do not edit.
// RQ correctness semantic boundary: a strict two-component reconfiguration precedence chain.
// Expected FG-DUCS decision: realizable.

set ControllableActions = {idle}

OLD_A = (idle -> OLD_A).
OLD_B = (idle -> OLD_B).
NEW_A = (idle -> NEW_A).
NEW_B = (idle -> NEW_B).

||OldEnvironment = (OLD_B || OLD_A).
||NewEnvironment = (NEW_B || NEW_A).

relation R_A_FG = {OLD_A@OLD_A = reconfigure_A -> NEW_A@NEW_A}
relation R_B_FG = {OLD_B@OLD_B = reconfigure_B -> NEW_B@NEW_B}

controllerSpec OldSpec = {
    controllable = {ControllableActions}
}
controller ||OldController = OldEnvironment~{OldSpec}.

controllerSpec NewSpec = {
    controllable = {ControllableActions}
}
controller ||NewController = NewEnvironment~{NewSpec}.

updatingController BoundaryCase = {
    oldController = OldController,
    newController = NewController,
    oldEnvironment = {OLD_B, OLD_A},
    newEnvironment = {NEW_B, NEW_A},
    mapRelation = {R_B_FG, R_A_FG},
    oldGoal = OldSpec,
    newGoal = NewSpec,
    precedence = {reconfigure_A < reconfigure_B},
    nonblocking,
    revised_on_the_fly,
    fine_grained
}
||UPDATE_CONTROLLER_OTF_FG = BoundaryCase.
