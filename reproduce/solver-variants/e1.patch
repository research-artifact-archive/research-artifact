@@ -0,0 +1,109 @@
+package ltsa.updatingControllers.otf;
+
+import java.util.*;
+import java.util.function.BiFunction;
+
+/** Contract preprocessing for the E1 ablation. No search/goal rule is changed. */
+final class ContractMerge {
+    private ContractMerge() { }
+
+    static <S, M> FineGrainedUpdateProblem<S, M> apply(
+            FineGrainedUpdateProblem<S, M> source, String mode) {
+        if ("none".equals(mode)) return source;
+        boolean transfers = "transfers".equals(mode) || "both".equals(mode);
+        boolean boundaries = "boundaries".equals(mode) || "both".equals(mode);
+        if (!transfers && !boundaries) throw new IllegalArgumentException(
+                "mtsa.otf.contractMerge must be none, transfers, boundaries, or both: " + mode);
+        if (!"none".equals(source.contractMerge())) throw new IllegalArgumentException("Already merged contract");
+        Map<String, String> labels = new LinkedHashMap<>();
+        for (String a : source.commonAlphabet()) labels.put(a, a);
+        if (transfers) for (VersionedComponent<S> c : source.components())
+            labels.put(c.reconfigureAction(), "ablation.merge.transfers");
+        if (boundaries) for (Requirement<S, M> r : source.requirements()) {
+            if (r.role() == RequirementRole.OLD) labels.put(r.stopAction().get(), "ablation.merge.stops");
+            if (r.role() == RequirementRole.NEW) labels.put(r.startAction().get(), "ablation.merge.starts");
+        }
+        for (String a : labels.keySet()) if (!a.equals(labels.get(a)) && source.commonAlphabet().contains(labels.get(a)))
+            throw new IllegalArgumentException("Merged label collides with original alphabet: " + labels.get(a));
+        Map<String, List<String>> groups = new LinkedHashMap<>();
+        for (String a : labels.keySet()) groups.computeIfAbsent(labels.get(a), k -> new ArrayList<>()).add(a);
+        FineGrainedUpdateProblem.Builder<S, M> b = FineGrainedUpdateProblem.<S, M>builder()
+                .normalActions(source.normalActions()).controllableNormalActions(source.controllableNormalActions())
+                .hotSwapActions(source.hotSwapInAction(), source.hotSwapOutAction())
+                .mergedContract(mode, source.hasExhaustiveEndpointCoverage());
+        for (VersionedComponent<S> c : source.components()) b.addComponent(new VersionedComponent<S>(
+                c.id(), c.oldLts(), c.newLts(), c.transferRelation(), labels.get(c.reconfigureAction()),
+                c.oldEnvironmentActions(), c.newEnvironmentActions()));
+        for (Requirement<S, M> r : source.requirements()) {
+            SafetyTester<M> t = tester(r.tester(), groups);
+            if (r.role() == RequirementRole.OLD) b.addRequirement(Requirement.oldRequirement(
+                    r.id(), t, labels.get(r.stopAction().get())));
+            else {
+                ActivationSpec<S, M> a = activation(r.requiredActivationSpec(), groups);
+                b.addRequirement(r.role() == RequirementRole.NEW
+                        ? Requirement.newRequirement(r.id(), t, a, labels.get(r.startAction().get()))
+                        : Requirement.updateTimeRequirement(r.id(), t, a));
+            }
+        }
+        // Retain strict precedence. A collapsed self-edge or induced cycle is
+        // an invalid transformed contract, never silently deleted.
+        for (String after : source.updateActions()) for (String before : source.directPredecessors(after))
+            b.addPrecedence(labels.get(before), labels.get(after));
+        for (CanonicalUpdateConfiguration<S, M> q : source.initialConfigurations()) {
+            Map<String, M> old = new LinkedHashMap<>();
+            for (String id : source.oldRequirementIds()) old.put(id, q.activeTesterStates().get(id));
+            b.addInitialSnapshot(new InitialSnapshot<S, M>(q.physicalState(), old));
+        }
+        for (GoalSignature<S, M> goal : source.goalSignatures()) b.addGoalSignature(goal);
+        return b.build();
+    }
+
+    private static <M> SafetyTester<M> tester(SafetyTester<M> t, Map<String, List<String>> groups) {
+        // Simultaneous observation is well-defined only when member updates
+        // commute. Check all states, not just the states visited by synthesis.
+        checkCommuting(t.states(), groups, t::stepOrStutter);
+        SafetyTester.Builder<M> b = SafetyTester.<M>builder().initialState(t.initialState()).addStates(t.states());
+        for (M error : t.errorStates()) b.addErrorState(error);
+        for (Map.Entry<String, List<String>> g : groups.entrySet()) {
+            if (Collections.disjoint(g.getValue(), t.alphabet())) continue;
+            for (M q : t.states()) b.addTransition(q, g.getKey(), step(q, g.getValue(), t::stepOrStutter));
+        }
+        return b.build();
+    }
+
+    private static <T> T step(T q, List<String> members, BiFunction<T, String, T> step) {
+        for (String a : members) q = step.apply(q, a);
+        return q;
+    }
+
+    private static <T> void checkCommuting(Set<T> states, Map<String, List<String>> groups,
+            BiFunction<T, String, T> step) {
+        for (List<String> members : groups.values()) for (int i = 0; i < members.size(); i++)
+            for (int j = i + 1; j < members.size(); j++) for (T q : states) {
+                String a = members.get(i), b = members.get(j);
+                if (!Objects.equals(step.apply(step.apply(q, a), b), step.apply(step.apply(q, b), a)))
+                    throw new IllegalArgumentException("Noncommuting monitor observations in merged event: " + a + ", " + b);
+            }
+    }
+
+    private static <S, M> ActivationSpec<S, M> activation(ActivationSpec<S, M> a,
+            Map<String, List<String>> groups) {
+        return activationTyped(a, a.residualLanguage(), groups);
+    }
+
+    @SuppressWarnings("unchecked") // The state belongs to this activation's original residual automaton.
+    private static <S, M, R> ActivationSpec<S, M> activationTyped(ActivationSpec<S, M> a,
+            final ResidualLanguage<R> old, final Map<String, List<String>> groups) {
+        checkCommuting(old.states(), groups, old::step);
+        ResidualLanguage<R> residual = new ResidualLanguage<R>() {
+            public Set<R> states() { return old.states(); }
+            public Set<String> alphabet() { return Collections.unmodifiableSet(groups.keySet()); }
+            public R initialState() { return old.initialState(); }
+            public boolean isError(R q) { return old.isError(q); }
+            public R step(R q, String action) { return ContractMerge.step(q, groups.get(action), old::step); }
+        };
+        ActivationSpec.Builder<S, M, R> b = ActivationSpec.builder(residual);
+        for (PhysicalState<S> p : a.domain()) b.put(p, a.activate(p), (R) a.residualStateAt(p).get());
+        return b.build();
+    }
+}
