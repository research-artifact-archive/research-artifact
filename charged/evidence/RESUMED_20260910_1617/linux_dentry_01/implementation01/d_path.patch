 /*
  * Write full pathname from the root of the filesystem into the buffer.
  */
+/* The upstream traversal is factored without changing its operations. */
+static void __dentry_path_body(const struct dentry *dentry,
+			       struct prepend_buffer *b, bool protected)
+{
+	dpath_body_begin(protected);
+	while (!IS_ROOT(dentry)) {
+		const struct dentry *parent = dentry->d_parent;
+
+		dpath_name_event();
+		dpath_mid_gate(dentry);
+		prefetch(parent);
+		if (!prepend_name(b, &dentry->d_name))
+			break;
+		dentry = parent;
+	}
+	dpath_body_end();
+}
