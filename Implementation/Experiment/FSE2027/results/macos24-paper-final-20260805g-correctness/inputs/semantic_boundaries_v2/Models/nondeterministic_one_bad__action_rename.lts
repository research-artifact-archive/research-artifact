// Semantic-boundary suite v2 case=nondeterministic_one_bad variant=action_rename.
// Metamorphic variants must preserve the registered decision.
// Generated by concrete-lts-semantic-boundaries-v2; do not edit.
// RQ correctness semantic boundary: one outcome of a nondeterministic transfer has no valid new-requirement activation.
// Expected FG-DUCS decision: unrealizable.

set ControllableActions = {heartbeat, violate}

OLD_COMPONENT = (heartbeat -> OLD_COMPONENT).
NEW_COMPONENT = NEW_GOOD,
NEW_GOOD = (heartbeat -> NEW_GOOD | violate -> NEW_BAD),
NEW_BAD = (heartbeat -> NEW_BAD).

||OldEnvironment = (OLD_COMPONENT).
||NewEnvironment = (NEW_COMPONENT).

relation R_COMPONENT_FG = {OLD_COMPONENT@OLD_COMPONENT = reconfigure_COMPONENT -> NEW_GOOD@NEW_COMPONENT,
    OLD_COMPONENT@OLD_COMPONENT = reconfigure_COMPONENT -> NEW_BAD@NEW_COMPONENT}

ltl_property P_NO_BAD = [](!violate)

controllerSpec OldSpec = {
    controllable = {ControllableActions}
}
controller ||OldController = OldEnvironment~{OldSpec}.

controllerSpec NewSpec = {
    safety = {P_NO_BAD}
    controllable = {ControllableActions}
}
controller ||NewController = NewEnvironment~{NewSpec}.

updatingController BoundaryCase = {
    oldController = OldController,
    newController = NewController,
    oldEnvironment = {OLD_COMPONENT},
    newEnvironment = {NEW_COMPONENT},
    mapRelation = {R_COMPONENT_FG},
    oldGoal = OldSpec,
    newGoal = NewSpec,
    nonblocking,
    revised_on_the_fly,
    fine_grained
}
||UPDATE_CONTROLLER_OTF_FG = BoundaryCase.
