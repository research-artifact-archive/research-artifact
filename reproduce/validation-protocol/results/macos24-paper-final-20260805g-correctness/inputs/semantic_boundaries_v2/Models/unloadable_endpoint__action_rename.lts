// Semantic-boundary suite v2 case=unloadable_endpoint variant=action_rename.
// Metamorphic variants must preserve the registered decision.
// Generated by independent-one-state-reconfiguration-v1; do not edit.
// RQ1 semantic boundary: transferred state has no valid new-requirement activation.
// Expected FG-DUCS decision: unrealizable.

set ControllableActions = {heartbeat, isolate}

OLD_COMPONENT = (heartbeat -> OLD_COMPONENT).
NEW_COMPONENT = NEW_READY,
NEW_READY = (heartbeat -> NEW_READY | isolate -> NEW_STRANDED),
NEW_STRANDED = (heartbeat -> NEW_STRANDED).

||OldEnvironment = (OLD_COMPONENT).
||NewEnvironment = (NEW_COMPONENT).

relation R_COMPONENT_FG = {OLD_COMPONENT@OLD_COMPONENT = reconfigure_COMPONENT -> NEW_STRANDED@NEW_COMPONENT}

ltl_property P_NO_STRAND = [](!isolate)

controllerSpec OldSpec = {
    controllable = {ControllableActions}
}
controller ||OldController = OldEnvironment~{OldSpec}.

controllerSpec NewSpec = {
    safety = {P_NO_STRAND}
    controllable = {ControllableActions}
}
controller ||NewController = NewEnvironment~{NewSpec}.

updatingController BoundaryCase = {
    oldController = OldController,
    newController = NewController,
    oldEnvironment = {OLD_COMPONENT},
    newEnvironment = {NEW_COMPONENT},
    mapRelation = {R_COMPONENT_FG},
    oldGoal = OldSpec,
    newGoal = NewSpec,
    nonblocking,
    revised_on_the_fly,
    fine_grained
}
||UPDATE_CONTROLLER_OTF_FG = BoundaryCase.
