+    private static FineGrainedUpdateProblem.Builder<String,Integer> base(boolean oldNormal,boolean newUc) {
+        FineGrainedUpdateProblem.Builder<String,Integer> b=FineGrainedUpdateProblem.builder();
+        for(int i=0;i<2;i++) {
