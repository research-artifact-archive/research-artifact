set ControllableActions = {idle, a, b, dA, dB}

BRANCH_OLD = WAIT,
WAIT = (idle -> WAIT | u -> BRANCH_A | u -> BRANCH_B),
BRANCH_A = (idle -> BRANCH_A | a -> READY_A),
BRANCH_B = (idle -> BRANCH_B | b -> READY_B),
READY_A = (idle -> READY_A | dA -> WAIT),
READY_B = (idle -> READY_B | dB -> WAIT).

BRANCH_NEW = NEW_A,
NEW_A = (idle -> NEW_A | dA -> NEW_B),
NEW_B = (idle -> NEW_B | dB -> NEW_A).

||OldEnvironment = (BRANCH_OLD).
||NewEnvironment = (BRANCH_NEW).

relation R_BRANCH_FG = {
  READY_A@BRANCH_OLD = reconfigure_BRANCH -> NEW_A@BRANCH_NEW,
  READY_B@BRANCH_OLD = reconfigure_BRANCH -> NEW_B@BRANCH_NEW
