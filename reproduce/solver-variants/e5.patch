+    }
+    private static PhysicalState<String> physical(boolean fresh,String q){return PhysicalState.of(TaggedState.of(fresh?ComponentVersion.NEW:ComponentVersion.OLD,q),TaggedState.of(fresh?ComponentVersion.NEW:ComponentVersion.OLD,q));}
+    private static <T>T only(Set<T> values){assertEquals(1,values.size());return values.iterator().next();}
