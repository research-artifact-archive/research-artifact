// Semantic-boundary suite v2 case=controllable_prefix variant=unreachable_declaration.
// Metamorphic variants must preserve the registered decision.
// Generated by concrete-lts-semantic-boundaries-v2; do not edit.
// RQ correctness semantic boundary: a normal controllable prefix reaches the only state with a defined component transfer.
// Expected FG-DUCS decision: realizable.

set ControllableActions = {idle, prepare}

OLD_COMPONENT = OLD_WAITING,
OLD_WAITING = (prepare -> OLD_PREPARED),
OLD_PREPARED = (idle -> OLD_PREPARED).
NEW_COMPONENT = (idle -> NEW_COMPONENT).

||OldEnvironment = (OLD_COMPONENT).
||NewEnvironment = (NEW_COMPONENT).

relation R_COMPONENT_FG = {OLD_PREPARED@OLD_COMPONENT = reconfigure_COMPONENT -> NEW_COMPONENT@NEW_COMPONENT}

controllerSpec OldSpec = {
    controllable = {ControllableActions}
}
controller ||OldController = OldEnvironment~{OldSpec}.

controllerSpec NewSpec = {
    controllable = {ControllableActions}
}
controller ||NewController = NewEnvironment~{NewSpec}.

updatingController BoundaryCase = {
    oldController = OldController,
    newController = NewController,
    oldEnvironment = {OLD_COMPONENT},
    newEnvironment = {NEW_COMPONENT},
    mapRelation = {R_COMPONENT_FG},
    oldGoal = OldSpec,
    newGoal = NewSpec,
    nonblocking,
    revised_on_the_fly,
    fine_grained
}
UNREACHABLE_AUX = (ghost -> UNREACHABLE_AUX).

||UPDATE_CONTROLLER_OTF_FG = BoundaryCase.
