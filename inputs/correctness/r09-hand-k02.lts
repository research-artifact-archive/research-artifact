// R09 proof-only ordinary-source fixture; not an evaluation input.
set C={idle}
O1=(idle->O1).
O2=(idle->O2).
||OE=(O1||O2).
N1=(idle->N1).
N2=(idle->N2).
||NE=(N1||N2).
relation R1={O1@O1=reconfigure_1->N1@N1}
relation R2={O2@O2=reconfigure_2->N2@N2}
controllerSpec OS={controllable={C}}
controller ||OC=OE~{OS}.
controllerSpec NS={controllable={C}}
controller ||NC=NE~{NS}.
updatingController H={
 oldController=OC,
 newController=NC,
 oldEnvironment={O1,O2},
 newEnvironment={N1,N2},
 mapRelation={R1,R2},
 oldGoal=OS,
 newGoal=NS,
 nonblocking,
 revised_on_the_fly,
 fine_grained
}
||H_OTF=H.
