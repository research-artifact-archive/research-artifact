+	private static M9EndpointReceiptBundle.PublishedReceipt
+			completeRegisteredM9EndpointAttempt(
+				CompositeState source,
+				ControllerGoal<String> goal,
+				LTSOutput output,
+				CompactState materializedEnew,
+				CompactStateEndpointAdmission.Admission enewAdmission,
+				M9CompositionProvenance.OrderedPrefixProjection environmentPrefix,
+				M9EndpointReceiptCore.Bindings receiptBindings,
+				M9EndpointReceiptBundle.PublicationTarget publicationTarget,
+				TraditionalPreGrSnapshotHook.SealedCapture traditionalPreGr,
+				M9EndpointSynthesisHook.Scope scope) throws IOException {
+			DeterministicLtsSynthesisCapture capture =
+					synthesiseRegisteredM9DeterministicEndpointOnce(
+							source, goal, output);
+			if (capture == null) {
+				throw new IllegalArgumentException(
+						"Registered endpoint synthesis returned no controller.");
+			}
+			M9CompositionProvenance.Projection plantAuthority =
+					M9CompositionProvenance.capture(
+							capture.plant, capture.environment);
+			M9EndpointStrategySnapshot strategy =
+					M9EndpointStrategySnapshot.capture(
+							capture.nativeController,
+							capture.plainController,
+							capture.nativeToPlainState,
+							capture.environment,
+							capture.plant,
+							plantAuthority,
+							environmentPrefix,
+							capture.legacyControllerRewriteActions,
+							capture.guaranteeCount,
+							capture.maxLaziness);
+			M9ClosedLoopEndpointSnapshot closedLoop =
+					M9ClosedLoopEndpointSnapshot.capture(
+							materializedEnew, enewAdmission,
+							capture.controller, strategy);
+			M9EndpointReceiptCore receipt = M9EndpointReceiptCore.capture(
+					receiptBindings, strategy, closedLoop,
+					traditionalPreGr.getSnapshot());
