+package ltsa.updatingControllers.otf;
+
+import java.util.*;
+
+/** Bounded, descriptive evidence from a checked losing certificate; not a causal diagnosis. */
+public final class LosingCertificateDiagnostics {
+    private LosingCertificateDiagnostics() { }
+    public static <Q,A,G> Map<String,Object> summarize(
+            ImplicitStrongGame<Q,A,G> game, OtfDucsResult<Q,A,G> result) {
+        return summarize(game, result, q -> Collections.<String,Object>emptyMap());
+    }
+    public static <Q,A,G> Map<String,Object> summarize(
+            ImplicitStrongGame<Q,A,G> game, OtfDucsResult<Q,A,G> result,
+            java.util.function.Function<Q,Map<String,Object>> additionalRootEvidence) {
+        if (result.isWinning()) throw new IllegalArgumentException("A losing certificate is required");
+        Set<Q> losing=result.losingCertificate().losingStates();
+        long unsafe=0, initial=0;
+        for(Q q:losing) if(!game.isSafe(q)) unsafe++;
+        List<Object> examples=new ArrayList<>();
+        for(Q q:game.initialStates()) if(losing.contains(q)) {
+            initial++;
+            if(examples.size()>=3) continue;
+            Map<String,Object> root=new LinkedHashMap<>();
+            root.put("state",String.valueOf(q));root.putAll(additionalRootEvidence.apply(q));
+            if(!game.isSafe(q)) root.put("local_obstruction","unsafe_initial_state");
+            else {
+                List<Object> actions=new ArrayList<>(); int enabled=0, uc=0, updates=0;
+                for(A action:game.candidateActions(q)) {
+                    Set<Q> targets=game.post(q,action); if(targets.isEmpty()) continue;
+                    enabled++; if(!game.isControllable(action)) uc++; if(game.isUpdateAction(action)) updates++;
+                    long bad=0; for(Q target:targets) if(losing.contains(target)) bad++;
+                    Map<String,Object> bucket=new LinkedHashMap<>();
+                    bucket.put("action",String.valueOf(action));bucket.put("controllable",game.isControllable(action));
+                    bucket.put("outcomes",targets.size());bucket.put("outcomes_in_certificate_region",bad);actions.add(bucket);
+                }
+                root.put("local_obstruction",uc>0?"enabled_uncontrollable_with_losing_outcome":
+                        enabled==0?"safe_non_goal_deadlock":"each_enabled_controllable_choice_has_losing_outcome");
+                root.put("enabled_uncontrollable_buckets",uc);root.put("enabled_update_buckets",updates);
+                root.put("enabled_action_buckets",actions);
+            }
+            examples.add(root);
+        }
+        Map<String,Object> summary=new LinkedHashMap<>();
+        summary.put("scope","checked discovered-state losing certificate; local root closure evidence, not a maximal whole-game region or causal explanation");
+        summary.put("region_states",losing.size());summary.put("unsafe_region_states",unsafe);summary.put("safe_region_states",losing.size()-unsafe);
+        summary.put("initial_states",game.initialStates().size());summary.put("losing_initial_states",initial);
+        summary.put("initial_examples_limit",3);summary.put("initial_examples",examples);
+        return Collections.unmodifiableMap(summary);
+    }
+}
