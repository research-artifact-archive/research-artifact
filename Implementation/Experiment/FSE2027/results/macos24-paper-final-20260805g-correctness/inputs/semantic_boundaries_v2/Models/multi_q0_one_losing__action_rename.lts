// RQ correctness semantic boundary: one of two reachable old-controller start states has no strongly completing update.
// Expected FG-DUCS decision: unrealizable.

set ControllableActions = {heartbeat, diverge}

OLD_COMPONENT = OLD_READY,
OLD_READY = (heartbeat -> OLD_READY | diverge -> OLD_LOSING),
OLD_LOSING = (heartbeat -> OLD_LOSING).
NEW_COMPONENT = (heartbeat -> NEW_COMPONENT).

||OldEnvironment = (OLD_COMPONENT).
||NewEnvironment = (NEW_COMPONENT).

relation R_COMPONENT_FG = {OLD_READY@OLD_COMPONENT = reconfigure_COMPONENT -> NEW_COMPONENT@NEW_COMPONENT}

controllerSpec OldSpec = {
    controllable = {ControllableActions}
}
controller ||OldController = OldEnvironment~{OldSpec}.

controllerSpec NewSpec = {
    controllable = {ControllableActions}
}
controller ||NewController = NewEnvironment~{NewSpec}.

updatingController BoundaryCase = {
    oldController = OldController,
    newController = NewController,
    oldEnvironment = {OLD_COMPONENT},
    newEnvironment = {NEW_COMPONENT},
    mapRelation = {R_COMPONENT_FG},
    oldGoal = OldSpec,
    newGoal = NewSpec,
    nonblocking,
    revised_on_the_fly,
    fine_grained
}
||UPDATE_CONTROLLER_OTF_FG = BoundaryCase.
